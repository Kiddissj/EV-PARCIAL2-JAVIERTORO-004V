<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.TitledPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox prefHeight="560.0" prefWidth="960.0" spacing="12.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="cl.duoc.viviendas.controller.MainController">
   <padding>
      <Insets bottom="16.0" left="20.0" right="20.0" top="16.0" />
   </padding>
   <children>
      <Label text="Registro de viviendas" style="-fx-font-size: 20px; -fx-font-weight: bold;" />
      <HBox spacing="24.0" VBox.vgrow="ALWAYS">
         <children>
            <VBox minWidth="380.0" prefWidth="380.0" spacing="10.0">
               <children>
                  <GridPane hgap="10.0" vgap="10.0">
                     <columnConstraints>
                        <ColumnConstraints minWidth="110.0" prefWidth="110.0" />
                        <ColumnConstraints hgrow="ALWAYS" />
                     </columnConstraints>
                     <children>
                        <Label text="Tipo:" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                        <ComboBox fx:id="cmbTipo" prefWidth="180.0" promptText="Seleccione..." GridPane.columnIndex="1" GridPane.rowIndex="0" />
                        <Label text="Código:" GridPane.columnIndex="0" GridPane.rowIndex="1" />
                        <TextField fx:id="txtCodigo" GridPane.columnIndex="1" GridPane.rowIndex="1" />
                        <Label text="Superficie (m²):" GridPane.columnIndex="0" GridPane.rowIndex="2" />
                        <TextField fx:id="txtSuperficie" maxWidth="100.0" GridPane.columnIndex="1" GridPane.rowIndex="2" />
                        <Label text="Habitaciones:" GridPane.columnIndex="0" GridPane.rowIndex="3" />
                        <TextField fx:id="txtHabitaciones" maxWidth="100.0" GridPane.columnIndex="1" GridPane.rowIndex="3" />
                     </children>
                  </GridPane>
                  <TitledPane fx:id="panelDepartamento" collapsible="false" disable="true" text="Datos del departamento">
                     <content>
                        <GridPane hgap="10.0" vgap="8.0">
                           <columnConstraints>
                              <ColumnConstraints minWidth="60.0" prefWidth="80.0" />
                              <ColumnConstraints hgrow="ALWAYS" />
                           </columnConstraints>
                           <padding>
                              <Insets bottom="6.0" left="6.0" right="6.0" top="6.0" />
                           </padding>
                           <children>
                              <Label text="Piso:" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                              <TextField fx:id="txtPiso" GridPane.columnIndex="1" GridPane.rowIndex="0" />
                              <CheckBox fx:id="chkGastoComunAlDia" text="Gasto común al día" GridPane.columnIndex="1" GridPane.rowIndex="1" />
                              <CheckBox fx:id="chkEstacionamiento" text="Estacionamiento asignado" GridPane.columnIndex="1" GridPane.rowIndex="2" />
                           </children>
                        </GridPane>
                     </content>
                  </TitledPane>
                  <TitledPane fx:id="panelCasa" collapsible="false" disable="true" text="Datos de la casa">
                     <content>
                        <GridPane hgap="10.0" vgap="8.0">
                           <columnConstraints>
                              <ColumnConstraints minWidth="60.0" prefWidth="80.0" />
                              <ColumnConstraints hgrow="ALWAYS" />
                           </columnConstraints>
                           <padding>
                              <Insets bottom="6.0" left="6.0" right="6.0" top="6.0" />
                           </padding>
                           <children>
                              <CheckBox fx:id="chkPatio" text="Cuenta con patio" GridPane.columnIndex="1" GridPane.rowIndex="0" />
                           </children>
                        </GridPane>
                     </content>
                  </TitledPane>
                  <HBox alignment="CENTER_RIGHT">
                     <children>
                        <Button defaultButton="true" mnemonicParsing="false" onAction="#onRegistrar" text="Registrar" />
                     </children>
                  </HBox>
               </children>
            </VBox>
            <VBox spacing="10.0" HBox.hgrow="ALWAYS">
               <children>
                  <TableView fx:id="tblViviendas" VBox.vgrow="ALWAYS">
                     <columns>
                        <TableColumn fx:id="colTipo" prefWidth="110.0" text="Tipo" />
                        <TableColumn fx:id="colCodigo" prefWidth="100.0" text="Código" />
                        <TableColumn fx:id="colSuperficie" prefWidth="120.0" text="Superficie (m²)" />
                        <TableColumn fx:id="colHabitaciones" prefWidth="110.0" text="Habitaciones" />
                        <TableColumn fx:id="colCosto" prefWidth="120.0" text="Costo arriendo" />
                     </columns>
                     <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                     </columnResizePolicy>
                  </TableView>
                  <Button mnemonicParsing="false" onAction="#onEliminar" text="Eliminar" />
               </children>
            </VBox>
         </children>
      </HBox>
      <Label fx:id="lblMensaje" minHeight="24.0" wrapText="true" />
   </children>
</VBox>
